# Google Maps Platform API key
# Obtain from: https://console.cloud.google.com/google/maps-apis/credentials
# Required APIs to enable in your project:
#   - Maps JavaScript API
#   - Geocoding API
#   - Directions API
#   - Places API
#   - Maps Static API

GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# (Optional) Comma-separated allowed CORS origins
# Default: all localhost origins are allowed
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
